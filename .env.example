# Copy to .env and fill in. .env is never committed. There is no default for a secret: compose refuses to start without one.

# ---- Secrets (generate each one: `openssl rand -base64 48` for the first two, `openssl rand -hex 8` for the salt)
# Back these up TOGETHER with the database backups: the tenant credentials stored in the database cannot be decrypted without them.
MASTER_DB_ROOT_PASSWORD=
JWT_SECRET=
TENANT_CREDENTIALS_KEY=
TENANT_CREDENTIALS_SALT=

# ---- Public address of the frontend (the board WebSocket refuses any other Origin; it is also the gateway's allowed CORS origin)
# Local, plain compose.yaml:
PUBLIC_ORIGIN=http://localhost:8080
# Production (compose.prod.yaml adds HTTPS through Caddy); use these instead of the line above:
#   PUBLIC_ORIGIN=https://sprintmodus.com
#   DOMAIN=sprintmodus.com
#   ACME_EMAIL=you@example.com
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory   # optional: a dry run against the staging CA first

# ---- Images: a released version (0.1.0) or a commit tag (sha-1a2b3c4), never latest
REGISTRY=ghcr.io/gdb-11
EUREKA_SERVER_TAG=
API_GATEWAY_TAG=
AUTH_SERVICE_TAG=
PROJECT_SERVICE_TAG=
WORKITEM_SERVICE_TAG=
FRONTEND_TAG=

# ---- Database (optional; these are the defaults)
# MYSQL_MAX_CONNECTIONS=500
# MYSQL_BUFFER_POOL_SIZE=512M
# MYSQL_MEMORY_LIMIT=1536m     # keep it well above the buffer pool; raise both together on a bigger machine

# MYSQL_BINLOG_RETENTION_SECONDS=604800   # binary logs are kept 7 days

# ---- Backups (optional; these are the defaults)
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
# BACKUP_DIR=/srv/sprintmodus/backups   # a host path, so it can be copied off the machine (default: a Docker volume)

# ---- Other optional settings
# FRONTEND_PORT=8080          # plain compose.yaml only; with compose.prod.yaml Caddy is the only public entry
# GATEWAY_PORT=8090
# HTTP_PORT=80
# HTTPS_PORT=443
# CORS_ALLOWED_ORIGINS defaults to PUBLIC_ORIGIN; comma-separate to also allow http://localhost:4200 (Angular dev server)
